# Copie para .env e preencha. O .env é ignorado pelo git — nunca commite valores reais.
# O spring-dotenv carrega este arquivo; variáveis de ambiente reais têm precedência.

# --- Aplicação -------------------------------------------------------------
# Assina os tokens de sessão (HMAC). Obrigatória fora do profile dev: sem ela
# o app se recusa a subir, porque uma chave previsível permite forjar sessão de admin.
APP_SECRET_KEY=
FRONTEND_URL=http://localhost:5173

# Modo demonstração: bloqueia toda escrita e a conexão de contas do Mercado Livre.
APP_DEMO_MODE=false

# --- Banco ----------------------------------------------------------------
DATABASE_URL=jdbc:postgresql://localhost:5432/myrias_ml_manager
DB_USER=
DB_PASSWORD=

# --- Mercado Livre (OAuth) -------------------------------------------------
MELI_APP_ID=
MELI_SECRET_KEY=
MELI_REDIRECT_URI=http://localhost:5173/api/auth/callback

# --- OpenRouter (assistente de IA) ----------------------------------------
OPENROUTER_API_KEY=
# Só modelos gratuitos podem ser selecionados. Desligar = assumir a fatura.
OPENROUTER_FREE_MODELS_ONLY=true
OPENROUTER_MODEL=openai/gpt-oss-20b:free

# --- Teto de gasto da IA --------------------------------------------------
# Bloqueia ANTES da chamada. Em modo demo a chave é o IP; fora dela, o usuário.
AI_KEY_DAILY_REQUESTS=20
AI_KEY_DAILY_COST=0.50
AI_GLOBAL_DAILY_COST=5.00
